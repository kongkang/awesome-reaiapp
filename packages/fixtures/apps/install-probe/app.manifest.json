{
  "manifestVersion": "1.1",
  "appId": "com.reai.install-probe",
  "version": "1.0.0",
  "publisherId": "reai",
  "name": "Install Probe",
  "description": "Host 安装、启停、Surface、Command、卸载与重装事务的最小测试夹具",
  "targets": [
    { "platform": "macos", "architectures": ["aarch64", "x86_64"] },
    { "platform": "windows", "architectures": ["aarch64", "x86_64"] }
  ],
  "hostApi": { "range": ">=1.1.0 <2.0.0" },
  "requires": {
    "hostCapabilities": ["surface.main@1", "storage.kv@1", "commands@1", "apps.intent@1"],
    "hardwareServices": [],
    "appIntents": []
  },
  "runtime": {
    "components": [
      {
        "id": "ui",
        "kind": "web-surface",
        "protocol": "web-surface@1",
        "required": true,
        "headless": false,
        "activation": "on-demand",
        "entry": "dist/app.js",
        "dependsOn": [],
        "lifecycle": {
          "activate": "default.activate",
          "deactivate": "default.deactivate"
        }
      }
    ]
  },
  "permissions": [],
  "requirementsVersion": "1.1",
  "requirements": [],
  "network": { "policyVersion": 1, "endpoints": [] },
  "billing": { "mode": "none" },
  "data": {
    "privateStores": [{ "id": "probe", "schemaVersion": 1 }],
    "imports": [],
    "exports": []
  },
  "contributes": {
    "surfaces": [
      { "id": "main", "componentId": "ui", "location": "app.main", "title": "Install Probe" }
    ],
    "sidebarItems": [],
    "commands": [
      {
        "id": "com.reai.install-probe.open",
        "componentId": "ui",
        "title": "Open install probe",
        "inputSchema": { "type": "object", "additionalProperties": false },
        "outputSchema": {
          "type": "object",
          "properties": { "status": { "const": "ok" } },
          "required": ["status"],
          "additionalProperties": false
        },
        "timeoutMs": 5000,
        "supportsCancellation": true,
        "concurrency": "serial",
        "idempotency": "idempotent",
        "callers": ["host"]
      }
    ],
    "intents": [
      {
        "id": "focus-input",
        "version": "1.0.0",
        "componentId": "ui",
        "opens": "surface:main",
        "inputSchema": { "type": "object", "additionalProperties": false }
      }
    ]
  }
}
