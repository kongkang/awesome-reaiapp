{
  "manifestVersion": "1.1",
  "appId": "com.example.minimal",
  "version": "1.0.0",
  "publisherId": "example",
  "name": "Minimal",
  "description": "工具链测试用的最小 App：只贡献一个 Surface 与一个 Command",
  "targets": [
    { "platform": "macos", "architectures": ["aarch64", "x86_64"] },
    { "platform": "windows", "architectures": ["aarch64", "x86_64"] }
  ],
  "hostApi": { "range": ">=1.1.0 <2.0.0" },
  "requires": {
    "hostCapabilities": ["surface.main@1", "storage.kv@1", "commands@1"],
    "hardwareServices": [],
    "appIntents": []
  },
  "runtime": {
    "components": [
      {
        "id": "ui",
        "kind": "web-surface",
        "protocol": "web-surface@1",
        "required": true,
        "headless": false,
        "activation": "on-demand",
        "entry": "dist/app.js",
        "dependsOn": [],
        "lifecycle": {
          "activate": "default.activate",
          "deactivate": "default.deactivate"
        }
      }
    ]
  },
  "permissions": [],
  "requirementsVersion": "1.1",
  "requirements": [],
  "network": { "policyVersion": 1, "endpoints": [] },
  "billing": { "mode": "none" },
  "data": {
    "privateStores": [{ "id": "notes", "schemaVersion": 1 }],
    "imports": [],
    "exports": []
  },
  "contributes": {
    "surfaces": [{ "id": "main", "componentId": "ui", "location": "app.main", "title": "Minimal" }],
    "sidebarItems": [],
    "commands": [
      {
        "id": "com.example.minimal.ping",
        "componentId": "ui",
        "title": "Ping",
        "inputSchema": { "type": "object", "additionalProperties": false },
        "outputSchema": {
          "type": "object",
          "properties": { "status": { "const": "ok" } },
          "required": ["status"],
          "additionalProperties": false
        },
        "timeoutMs": 3000,
        "supportsCancellation": false,
        "concurrency": "serial",
        "idempotency": "idempotent",
        "callers": ["host"]
      }
    ],
    "intents": []
  }
}
