{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reai.com/schemas/skin-v1.schema.json",
  "title": "ReAI Driver V2 Skin v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "shell", "layout", "tokens"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 48 },
        "description": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "brand", "primaryOrder", "searchPlaceholder"],
      "properties": {
        "variant": { "type": "string", "enum": ["left-rail", "top-bar-bottom-dock"] },
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wordmark", "kicker"],
          "properties": {
            "wordmark": { "type": "string", "minLength": 1, "maxLength": 32 },
            "kicker": { "type": "string", "minLength": 1, "maxLength": 48 }
          }
        },
        "primaryOrder": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["home", "device", "extstore", "installed", "terminal", "settings", "account"] }
        },
        "searchPlaceholder": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["railWidth", "topbarHeight", "dockHeight", "radius", "density", "pagePreset"],
      "properties": {
        "railWidth": { "type": "integer", "minimum": 56, "maximum": 104 },
        "topbarHeight": { "type": "integer", "minimum": 76, "maximum": 140 },
        "dockHeight": { "type": "integer", "minimum": 56, "maximum": 96 },
        "radius": { "type": "integer", "minimum": 0, "maximum": 24 },
        "density": { "type": "string", "enum": ["compact", "comfortable"] },
        "pagePreset": { "type": "string", "enum": ["console", "editorial"] }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": { "type": "object" },
        "dark": { "type": "object" }
      }
    }
  }
}
