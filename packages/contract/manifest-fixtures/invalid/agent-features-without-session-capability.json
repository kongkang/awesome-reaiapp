{
  "manifestVersion": "1.1",
  "appId": "com.example.agent-features",
  "version": "1.0.0",
  "publisherId": "example",
  "name": "Agent Features No V2",
  "description": "声明 Agent 功能但未声明 agent.session@2 的反例",
  "icon": "assets/icon.svg",
  "targets": [
    {
      "platform": "macos",
      "architectures": [
        "aarch64"
      ]
    }
  ],
  "hostApi": {
    "range": ">=1.23.0 <2.0.0"
  },
  "requires": {
    "hostCapabilities": [
      "surface.main@1",
      "sidebar.item@1",
      "storage.kv@1",
      "commands@1",
      "apps.intent@1"
    ],
    "hardwareServices": [],
    "appIntents": []
  },
  "runtime": {
    "components": [
      {
        "id": "ui",
        "kind": "web-surface",
        "protocol": "web-surface@1",
        "required": true,
        "headless": false,
        "activation": "on-demand",
        "entry": "dist/app.js",
        "dependsOn": [],
        "lifecycle": {
          "activate": "default.activate",
          "deactivate": "default.deactivate"
        }
      }
    ]
  },
  "permissions": [],
  "requirementsVersion": "1.1",
  "requirements": [],
  "network": {
    "policyVersion": 1,
    "endpoints": []
  },
  "billing": {
    "mode": "none"
  },
  "data": {
    "privateStores": [],
    "imports": [],
    "exports": []
  },
  "dataCompatibility": {
    "rollbackFloor": "1.0.0"
  },
  "contributes": {
    "surfaces": [
      {
        "id": "main",
        "componentId": "ui",
        "location": "app.main",
        "title": "Agent Features"
      }
    ],
    "sidebarItems": [
      {
        "id": "features",
        "label": "Features",
        "icon": "assets/icon.svg",
        "opens": "surface:main"
      }
    ],
    "commands": [],
    "agentFeatures": [
      {
        "id": "translation",
        "name": "翻译",
        "promptTemplate": "你是翻译引擎。目标语言：{targetLanguage}。",
        "promptParams": [
          {
            "name": "targetLanguage",
            "description": "本次翻译的目标语言"
          }
        ],
        "toolBase": []
      }
    ]
  }
}
