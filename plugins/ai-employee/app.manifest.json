{
  "manifestVersion": "1.1",
  "appId": "com.example.ai-employee",
  "version": "0.1.0",
  "publisherId": "example",
  "name": "AI 员工工作台",
  "description": "原始资料、标准记录与岗位 Agent 的三阶段插件范式 Demo",
  "icon": "assets/icon.png",
  "storeListing": {
    "category": "Productivity",
    "tagline": "让每一条结论，都能回到原始事实。",
    "longDescription": "本地开发 Demo：上传与保留原件，按岗位整理为可编辑记录，由明确标记的演示分析生成报告。真实平台 Agent 接入需另行能力批准，尚未上架。",
    "capabilities": [
      {
        "label": "资料与记录",
        "detail": "本地保存原件和修订记录"
      },
      {
        "label": "岗位模板",
        "detail": "财务、人事与可导出的开发配置"
      },
      {
        "label": "演示分析",
        "detail": "规则计算与报表，不调用大模型"
      }
    ],
    "screenshots": [
      {
        "gradient": "linear-gradient(135deg,#ececf5,#ffffff)",
        "caption": "可追溯的三阶段工作台 Demo",
        "hasVideo": false
      }
    ]
  },
  "targets": [
    {
      "platform": "macos",
      "architectures": [
        "aarch64",
        "x86_64"
      ]
    },
    {
      "platform": "windows",
      "architectures": [
        "aarch64",
        "x86_64"
      ]
    }
  ],
  "hostApi": {
    "range": ">=1.20.0 <2.0.0"
  },
  "requires": {
    "hostCapabilities": [
      "surface.main@1",
      "sidebar.item@1",
      "storage.kv@1",
      "commands@1",
      "apps.intent@1",
      "titlebar.action@1"
    ],
    "hardwareServices": [],
    "appIntents": []
  },
  "runtime": {
    "components": [
      {
        "id": "ui",
        "kind": "web-surface",
        "protocol": "web-surface@1",
        "required": true,
        "headless": false,
        "activation": "on-demand",
        "entry": "dist/app.js",
        "dependsOn": [],
        "lifecycle": {
          "activate": "default.activate",
          "deactivate": "default.deactivate"
        }
      }
    ]
  },
  "permissions": [],
  "requirementsVersion": "1.1",
  "requirements": [],
  "network": {
    "policyVersion": 1,
    "endpoints": []
  },
  "billing": {
    "mode": "none"
  },
  "data": {
    "privateStores": [
      {
        "id": "employee",
        "schemaVersion": 1
      }
    ],
    "imports": [],
    "exports": []
  },
  "dataCompatibility": {
    "rollbackFloor": "0.1.0"
  },
  "contributes": {
    "surfaces": [
      {
        "id": "main",
        "componentId": "ui",
        "location": "app.main",
        "title": "AI 员工工作台"
      }
    ],
    "sidebarItems": [
      {
        "id": "employee",
        "label": "AI 员工",
        "icon": "assets/icon.png",
        "opens": "surface:main"
      }
    ],
    "titlebarActions": [
      {
        "id": "settings",
        "label": "设置",
        "icon": "settings",
        "showOnTitlebarHover": true,
        "intent": {
          "type": "open-settings"
        }
      }
    ],
    "commands": [
      {
        "id": "com.example.ai-employee.open",
        "componentId": "ui",
        "title": "打开 AI 员工工作台",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "const": "ok"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "timeoutMs": 5000,
        "supportsCancellation": true,
        "concurrency": "serial",
        "idempotency": "idempotent",
        "callers": [
          "host",
          "user"
        ]
      }
    ],
    "intents": [
      {
        "id": "open-settings",
        "version": "1.0.0",
        "componentId": "ui",
        "opens": "surface:main",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        }
      }
    ]
  }
}
