{
  "name": "reai-ni-chat-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "reaiApp": {
    "entry": "src/app.ts"
  },
  "scripts": {
    "test": "bun test --pass-with-no-tests tests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/ni-chat-ui",
    "build": "reai-app build .",
    "validate": "reai-app validate .",
    "test:contract": "reai-app contract-test . --host-api 1.1",
    "pack": "reai-app pack . --out ni-chat-1.0.0.reaiapp"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@reai/agent-ui": "file:../../packages/ui/agent-ui",
    "@reai/ni-chat-ui": "file:./packages/ni-chat-ui",
    "@reai/app-cli": "file:../../packages/cli",
    "@reai/app-contract": "file:../../packages/contract",
    "@reai/app-sdk": "file:../../packages/sdk",
    "@reai/app-test": "file:../../packages/test-kit",
    "@types/bun": "^1.3.14",
    "typescript": "~5.6.0"
  },
  "overrides": {
    "@reai/agent-ui": "file:../../packages/ui/agent-ui",
    "@reai/ni-chat-ui": "file:./packages/ni-chat-ui",
    "@reai/app-cli": "file:../../packages/cli",
    "@reai/app-contract": "file:../../packages/contract",
    "@reai/app-sdk": "file:../../packages/sdk",
    "@reai/app-test": "file:../../packages/test-kit"
  }
}
